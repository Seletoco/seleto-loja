# Nomes das variáveis (valores NUNCA vão para o Git: defina na Vercel).

# Banco (perfil restrito loja_app; a senha você define na migration 002)
LOJA_DATABASE_URL=
# Assina a sessão do cliente (16+ caracteres aleatórios)
LOJA_SESSAO_SECRET=

# Admin (/admin). Com o banco ligado, o admin fica BLOQUEADO sem estes três.
ADMIN_USUARIO=
ADMIN_SENHA=            # 12+ caracteres
ADMIN_SEGREDO=          # 16+ caracteres aleatórios

# Modo real: tira os avisos de teste e libera o Google. Precisa estar definido ANTES do build.
NEXT_PUBLIC_MODO_REAL=

# Contato e confiança (opcionais; só aparecem se definidos)
# Endereço público do site (com https://, sem barra no fim). Usado em sitemap, canonical e prévias. Padrão: https://seleto-loja.vercel.app
NEXT_PUBLIC_SITE_URL=
# WhatsApp da Seleto Store (DDD+número). Liga o balão flutuante, o rodapé e o telefone nos dados do Google.
NEXT_PUBLIC_WHATSAPP_SELETO=
NEXT_PUBLIC_WHATSAPP_TAQUARA=
NEXT_PUBLIC_WHATSAPP_AEROTOWN=
NEXT_PUBLIC_WHATSAPP_AMERICAS=
NEXT_PUBLIC_WHATSAPP_NOVA_IGUACU=
NEXT_PUBLIC_GOOGLE_AVALIACAO_URL=
NEXT_PUBLIC_CLIENTES_ATENDIDOS=

# Páginas legais (opcionais)
NEXT_PUBLIC_EMPRESA_RAZAO=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_CONTATO_PRIVACIDADE=
NEXT_PUBLIC_TROCA_DIAS=

# Frete (Correios; sem eles o site usa estimativa)
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CONTRATO=
CORREIOS_DR=
CEP_ORIGEM=
FRETE_GRATIS_ACIMA=
NEXT_PUBLIC_BLACK_FRIDAY=      # 1 = mostra a faixa de Black Friday em PRODUÇÃO (em prévia ela aparece sempre)
NEXT_PUBLIC_EXIGIR_LOGIN=      # 1 = só finaliza pedido quem tem conta e está logado (padrão: desligado)

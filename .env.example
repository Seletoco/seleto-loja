# Nomes das variáveis (valores NUNCA vão para o Git: defina na Vercel).

# Banco (perfil restrito loja_app; a senha você define na migration 002)
LOJA_DATABASE_URL=
# Assina a sessão do cliente (16+ caracteres aleatórios)
LOJA_SESSAO_SECRET=

# Admin (/admin). Com o banco ligado, o admin fica BLOQUEADO sem estes três.
ADMIN_USUARIO=
ADMIN_SENHA=            # 12+ caracteres
ADMIN_SEGREDO=          # 16+ caracteres aleatórios

# Modo real: tira os avisos de teste e libera o Google. Precisa estar definido ANTES do build.
NEXT_PUBLIC_MODO_REAL=

# Contato e confiança (opcionais; só aparecem se definidos)
# Endereço público do site (com https://, sem barra no fim). Usado em sitemap, canonical e prévias. Padrão: https://seleto-loja.vercel.app
NEXT_PUBLIC_SITE_URL=
# WhatsApp da Seleto Store (DDD+número). Liga o balão flutuante, o rodapé e o telefone nos dados do Google.
# Domínio do SeleChat para os links dos grupos (/v/ouro, /v/diamante, /farm). Padrão: https://chat.seletoco.com.br
NEXT_PUBLIC_CHAT_URL=
NEXT_PUBLIC_WHATSAPP_SELETO=
NEXT_PUBLIC_WHATSAPP_TAQUARA=
NEXT_PUBLIC_WHATSAPP_AEROTOWN=
NEXT_PUBLIC_WHATSAPP_AMERICAS=
NEXT_PUBLIC_WHATSAPP_NOVA_IGUACU=
NEXT_PUBLIC_GOOGLE_AVALIACAO_URL=
NEXT_PUBLIC_CLIENTES_ATENDIDOS=

# Páginas legais (opcionais)
NEXT_PUBLIC_EMPRESA_RAZAO=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_CONTATO_PRIVACIDADE=
NEXT_PUBLIC_TROCA_DIAS=

# Frete pelo Melhor Envio (tem prioridade). Token: Melhor Envio > Gestão > Integrações. E-mail: contato técnico da loja (o Melhor Envio exige no User-Agent).
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_EMAIL=
# sandbox só para testar com token de sandbox; vazio = produção
MELHOR_ENVIO_AMBIENTE=
# Frete pelos Correios com contrato (usado se o Melhor Envio não estiver configurado; sem nenhum, o site usa estimativa)
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CONTRATO=
CORREIOS_DR=
CEP_ORIGEM=
FRETE_GRATIS_ACIMA=
NEXT_PUBLIC_BLACK_FRIDAY=      # 1 = mostra a faixa de Black Friday em PRODUÇÃO (em prévia ela aparece sempre)
NEXT_PUBLIC_EXIGIR_LOGIN=      # 1 = só finaliza pedido quem tem conta e está logado (padrão: desligado)

# Pagamento pela Rede (e.Rede / Rede Labs). Segredos como Secret na Vercel; nunca no código nem no chat.
# REDE_AMBIENTE: sandbox (padrão) ou producao. REDE_ATIVO=1 só depois dos testes (hoje nada cobra ainda).
REDE_AMBIENTE=
# PV = clientId; Chave de Integração (Portal Use Rede) = clientSecret. REDE_CLIENT_ID só se for diferente do PV.
REDE_PV=
REDE_CLIENT_SECRET=
REDE_CLIENT_ID=
REDE_ATIVO=
# Cartão de crédito (checkout transparente pela Rede). CARTAO_ATIVO=1 liga o cartão (precisa das credenciais acima; em produção também REDE_ATIVO=1).
CARTAO_ATIVO=
# Parcelas sem juros (1 a 12; padrão 1 = só à vista) e valor mínimo da parcela em reais (padrão 50).
CARTAO_PARCELAS_MAX=
CARTAO_PARCELA_MINIMA=
# Texto na fatura do cartão (até 18 letras/números). Só use se a Rede já habilitou o soft descriptor no seu PV.
REDE_SOFT_DESCRIPTOR=

# API "Tray" do site para o PDVNet (nota fiscal). As quatro juntas ligam a API real; só pedidos liberados no admin são entregues.
# Consumer Key/Secret: os mesmos da tela da Tray no PDVNet. Código e segredo do token: invente senhas longas e aleatórias (Sensitive).
TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=
TRAY_CODIGO=
TRAY_SEGREDO_TOKEN=
# Só para diagnóstico: registra nos logs o que o PDVNet chama (sem segredos). Desligue depois.
TRAY_CAPTURA=
